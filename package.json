{
  "name": "easyskillz",
  "version": "0.5.0",
  "description": "Single source of truth for AI agent skills across multiple tools",
  "main": "index.js",
  "bin": {
    "easyskillz": "bin/easyskillz.js"
  },
  "files": [
    "src/",
    "bin/",
    "index.js"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:contract && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:contract": "node --test tests/contract/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 tests/unit/*.test.js tests/contract/*.test.js tests/integration/*.test.js tests/e2e/*.test.js",
    "test:acceptance": "node scripts/check-acceptance-coverage.js",
    "test:package": "node scripts/test-package.js",
    "ci": "npm run test:acceptance && npm test && npm run test:coverage && npm run test:package"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "skills",
    "claude",
    "cursor",
    "codex",
    "copilot",
    "gemini",
    "windsurf",
    "agent",
    "devin",
    "antigravity",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DurdeuVlad/easyskillz.git"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DurdeuVlad/easyskillz/issues"
  },
  "homepage": "https://github.com/DurdeuVlad/easyskillz#readme",
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "node-pty": "^1.1.0"
  }
}
